HTML 
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0b1020">
  <meta name="description" content="Davis's personal portfolio, skills and projects.">
  <title>Davis | Personal Portfolio</title>

  <style>
    :root {
      --bg: #0b1020;
      --panel: #121a2e;
      --text: #f5f7ff;
      --muted: #a7b1c8;
      --accent: #64e6b1;
      --line: #26334d;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: system-ui, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
    }

    a { color: inherit; text-decoration: none; }

    .container {
      width: min(1080px, 90%);
      margin: auto;
    }

    header {
      padding: 20px 0;
      border-bottom: 1px solid var(--line);
    }

    nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .logo {
      font-size: 1.25rem;
      font-weight: 800;
    }

    .logo span { color: var(--accent); }

    .nav-links {
      display: flex;
      gap: 18px;
      flex-wrap: wrap;
      font-size: .9rem;
      color: var(--muted);
    }

    .nav-links a:hover { color: var(--accent); }

    .hero { padding: 85px 0 70px; }

    .eyebrow {
      color: var(--accent);
      font-weight: 700;
      letter-spacing: 2px;
      font-size: .8rem;
      text-transform: uppercase;
    }

    h1 {
      font-size: clamp(2.7rem, 9vw, 5rem);
      line-height: 1.08;
      letter-spacing: -2px;
      margin: 18px 0;
    }

    h1 span { color: var(--accent); }

    .hero p, .section-intro {
      color: var(--muted);
      max-width: 620px;
    }

    .actions {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      margin-top: 28px;
    }

    .btn {
      display: inline-block;
      padding: 12px 20px;
      border-radius: 9px;
      font-weight: 750;
      border: 1px solid var(--accent);
    }

    .primary {
      color: #07130f;
      background: var(--accent);
    }

    .secondary { color: var(--accent); }

    section { padding: 60px 0; }

    .section-title {
      font-size: clamp(1.8rem, 5vw, 2.5rem);
      margin-bottom: 12px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 18px;
      margin-top: 28px;
    }

    .card {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 15px;
      padding: 24px;
    }

    .card h3 { margin-bottom: 10px; }

    .card p { color: var(--muted); }

    .tag {
      display: inline-block;
      color: var(--accent);
      background: #17332f;
      border-radius: 6px;
      padding: 3px 9px;
      margin: 12px 5px 0 0;
      font-size: .8rem;
    }

    .contact-box {
      background: linear-gradient(135deg, #142c2a, #121a2e);
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 28px;
    }

    footer {
      border-top: 1px solid var(--line);
      padding: 25px 0;
      color: var(--muted);
      font-size: .9rem;
      text-align: center;
    }

    @media (max-width: 480px) {
      .hero { padding-top: 60px; }
      .nav-links { gap: 12px; }
      .card { padding: 20px; }
    }
  </style>
</head>

<body>
  <header>
    <nav class="container">
      <a class="logo" href="#home">DAVIS<span>.</span></a>
      <div class="nav-links">
        <a href="#about">About</a>
        <a href="#skills">Skills</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="hero container" id="home">
      <div class="eyebrow">Welcome to my portfolio</div>
      <h1>Hi, I'm Davis.<br>
        I build <span>digital ideas.</span>
      </h1>
      <p>
        I'm an aspiring web developer and entrepreneur,
        learning to turn ideas into useful digital experiences.
        I'm passionate about technology, business and continuous growth.
      </p>
      <div class="actions">
        <a class="btn primary" href="#projects">Explore My Work</a>
        <a class="btn secondary" href="#contact">Contact Me</a>
      </div>
    </section>

    <section id="about">
      <div class="container">
        <h2 class="section-title">About Me</h2>
        <p class="section-intro">
          I'm Davis, a self-driven learner with an entrepreneurial
          mindset. My interests include web development, technology
          and building practical solutions for everyday problems.
          I'm developing my skills one project at a time.
        </p>
      </div>
    </section>

    <section id="skills">
      <div class="container">
        <h2 class="section-title">My Skills</h2>
        <p class="section-intro">
          Skills I'm learning and developing as I grow.
        </p>
        <div class="grid">
          <article class="card">
            <h3>HTML</h3>
            <p>Creating the structure and content of web pages.</p>
            <span class="tag">Learning</span>
          </article>
          <article class="card">
            <h3>CSS</h3>
            <p>Designing responsive layouts, colours and visual styles.</p>
            <span class="tag">Learning</span>
          </article>
          <article class="card">
            <h3>JavaScript</h3>
            <p>Learning to make websites interactive and dynamic.</p>
            <span class="tag">Learning</span>
          </article>
          <article class="card">
            <h3>Entrepreneurship</h3>
            <p>Exploring business ideas and technology-driven solutions.</p>
            <span class="tag">Developing</span>
          </article>
        </div>
      </div>
    </section>

    <section id="projects">
      <div class="container">
        <h2 class="section-title">My Projects</h2>
        <p class="section-intro">
          A place to showcase my work as I build and publish projects.
        </p>
        <div class="grid">
          <article class="card">
            <h3>Personal Portfolio</h3>
            <p>A responsive website introducing me, my skills and my goals.</p>
            <span class="tag">HTML</span>
            <span class="tag">CSS</span>
            <span class="tag">JavaScript</span>
          </article>
          <article class="card">
            <h3>Business Website</h3>
            <p>A planned project to help showcase products and connect with customers.</p>
            <span class="tag">Coming soon</span>
          </article>
          <article class="card">
            <h3>Web App Projects</h3>
            <p>Exploring useful web applications for individuals and businesses.</p>
            <span class="tag">In progress</span>
          </article>
        </div>
      </div>
    </section>

    <section id="contact">
      <div class="container">
        <div class="contact-box">
          <h2 class="section-title">Let's Connect</h2>
          <p class="section-intro">
            Have a project, opportunity or idea to discuss?
            I'd be happy to hear from you.
          </p>
          <div class="actions">
            <a class="btn primary"
               href="mailto:your-email@example.com">
              Email Me
            </a>
            <a class="btn secondary"
               href="https://github.com/">
              GitHub
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <p>© <span id="year"></span> Davis. Built with purpose.</p>
    </div>
  </footer>

  <script>
    document.getElementById("year").textContent =
      new Date().getFullYear();
  </script>
</body>
</html>
